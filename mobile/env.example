# Variables d'environnement pour l'API SIRA KELEN
# Copier ce fichier vers .env (gitignore) ou passer les variables avec --dart-define.

# URL de l'API backend NestJS (obligatoire)
# Exemple production : https://sirakele-api.onrender.com
# Exemple local      : http://192.168.1.23:8080
apiBaseUrl=https://sirakele-api.onrender.com

# Utilisation :
#   flutter run -d chrome --dart-define=apiBaseUrl=https://sirakele-api.onrender.com
#   flutter build web --release --dart-define=apiBaseUrl=https://sirakele-api.onrender.com
#   flutter build apk --debug --dart-define=apiBaseUrl=https://sirakele-api.onrender.com
