# Variables d'environnement pour SIRA KELEN
# Passer les variables avec --dart-define (frontend) ou .env (backend).

# === FRONTEND (--dart-define) ===

# URL de l'API backend NestJS
apiBaseUrl=https://sirakele-api.onrender.com

# Client ID Google OAuth — UNIQUEMENT pour Google Sign-In sur le WEB.
# A recuperer dans Google Cloud Console > APIs & Services > Credentials
# > OAuth 2.0 Client ID de type "Application Web".
# Si vide : le bouton Google est masqué sur le web (évite le plantage
# "Null check operator used on a null value"). Android reste inchangé.
googleClientId=

# Exemples :
#   flutter run -d chrome --dart-define=apiBaseUrl=https://sirakele-api.onrender.com --dart-define=googleClientId=VOTRE_ID
#   flutter build web --release --dart-define=apiBaseUrl=https://sirakele-api.onrender.com --dart-define=googleClientId=VOTRE_ID

# === BACKEND (.env sur Render) — GMAIL SMTP UNIQUEMENT ===

# Gmail SMTP (envoi des codes OTP par email)
# SMTP_USER=diassanaissiaka68@gmail.com
# SMTP_PASS=mot_de_passe_application_gmail
# SMTP_FROM=SIRA KELEN <diassanaissiaka68@gmail.com>
#
# Un timeout de 8s est appliqué à l'envoi pour ne jamais bloquer l'endpoint.
# Si SMTP n'est pas configuré, le code est affiché dans les logs (mode dev).
