# Variables d'environnement pour SIRA KELEN
# Passer les variables avec --dart-define (ne jamais mettre de secret ici).

# URL de l'API backend NestJS (obligatoire)
# Exemple production : https://sirakele-api.onrender.com
# Exemple local      : http://192.168.1.23:8080
apiBaseUrl=https://sirakele-api.onrender.com

# Client ID Google OAuth (uniquement pour Google Sign-In sur le WEB)
# A recuperer dans Google Cloud Console > APIs & Services > Credentials
# > OAuth 2.0 Client ID > type "Application Web". Laisser vide pour desactiver
# la connexion Google sur le web (elle reste active sur Android).
# Exemple : 743493937262-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
googleClientId=

# Utilisation :
#   flutter run -d chrome --dart-define=apiBaseUrl=https://sirakele-api.onrender.com --dart-define=googleClientId=VOTRE_CLIENT_ID
#   flutter build web --release --dart-define=apiBaseUrl=https://sirakele-api.onrender.com --dart-define=googleClientId=VOTRE_CLIENT_ID
#   flutter build apk --release --dart-define=apiBaseUrl=https://sirakele-api.onrender.com
